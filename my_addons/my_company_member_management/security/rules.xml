<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Global Multi-Company Rules -->
        <record id="rule_member_approval_multi_company" model="ir.rule">
            <field name="name">Member Approval Multi-Company Rule</field>
            <field name="model_id" ref="model_company_member_approval"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id.id', '=', user.company_id.id)]</field>
        </record>

        <!-- Company Admin Rules -->
        <record id="rule_company_admin_users" model="ir.rule">
            <field name="name">Company Admin - Users Rule</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="groups" eval="[(4, ref('group_single_company_admin'))]"/>
            <field name="domain_force">[('company_id.id', '=', user.company_id.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Company User Rules -->
        <record id="rule_company_user_users" model="ir.rule">
            <field name="name">Company User - Users Rule</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="groups" eval="[(4, ref('group_single_company_user'))]"/>
            <field name="domain_force">[('company_id.id', '=', user.company_id.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>